<?xml version="1.0" encoding="utf-8"?>
<!-- User and error bubbles — design.md §10: 1.5 dp border, 4 dp radius, no fill and no shadow.
     The assistant bubble has no background at all; drawing a box around most of the screen
     costs ink per line for no information. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paper" />
    <stroke android:width="1.5dp" android:color="@color/ink_900" />
    <corners android:radius="@dimen/ink_radius" />
</shape>
