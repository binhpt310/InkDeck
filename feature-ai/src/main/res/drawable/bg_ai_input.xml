<?xml version="1.0" encoding="utf-8"?>
<!-- Composer and settings fields. A 1.5 dp box, not the platform underline: the underline is
     drawn in colorAccent, animates its thickness on focus, and a hairline under text vanishes
     against the divider below it. Same shape as feature-tasks' bg_input, duplicated rather than
     shared because a drawable in :core-eink is not this module's to add. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paper" />
    <stroke android:width="1.5dp" android:color="@color/ink_900" />
    <corners android:radius="@dimen/ink_radius" />
</shape>
