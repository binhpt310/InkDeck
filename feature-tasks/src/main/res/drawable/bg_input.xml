<?xml version="1.0" encoding="utf-8"?>
<!--
  Text-field outline. A 1.5 dp box, not the platform's underline: the underline is drawn in
  colorAccent and animates its thickness on focus, and a single hairline under text on a
  dithered panel disappears against the row divider below it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paper" />
    <stroke android:width="1.5dp" android:color="@color/ink_900" />
    <corners android:radius="@dimen/ink_radius" />
</shape>
