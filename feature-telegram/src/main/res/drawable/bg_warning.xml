<?xml version="1.0" encoding="utf-8"?>
<!--
  design.md §12: "Warnings are bordered, never colour-tinted — a #FFF3CD amber wash becomes an
  indistinguishable pale grey after dithering." A 1.5 dp ink_900 box on paper is the only thing
  on this panel that reads as a warning rather than as another card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paper" />
    <stroke android:width="1.5dp" android:color="@color/ink_900" />
    <corners android:radius="@dimen/ink_radius" />
</shape>
